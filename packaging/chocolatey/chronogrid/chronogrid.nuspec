    <releaseNotes>https://github.com/karencohenjw/chronogrid/releases/tag/v0.2.0</releaseNotes>
    <copyright>Copyright (c) 2026 Karen Cohen</copyright>
    <tags>chronogrid calendar timezone datetime temporal ics icalendar rrule cli developer testing open-source</tags>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
